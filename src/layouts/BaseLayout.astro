---
import '../styles/fonts.css';
import { PROFILE } from '../data/profile';
import { POSTER_VARIANTS } from '../data/poster-variants';
import { HOME_TITLE, SOCIAL_IMAGE, pageUrl, serializeJsonLd, structuredData } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  path?: '/' | '/portfolio/';
  animated?: boolean;
}

const { title = HOME_TITLE, description = PROFILE.description, path = '/', animated = false } = Astro.props;
const canonical = pageUrl(path, Astro.site);
const image = pageUrl(SOCIAL_IMAGE, Astro.site);
const schema = structuredData({ title, description, path, site: Astro.site });
const openingPoster = POSTER_VARIANTS['/media/2f384c20c92f9ef944f51c81c3f9d7f9.webp'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" href="/fonts/figtree-400.woff2" type="font/woff2" crossorigin />
    {animated && <>
      <link rel="preload" as="font" href="/fonts/latin/caveat-500.woff2" type="font/woff2" crossorigin />
      <link rel="preload" as="font" href="/fonts/latin/caveat-700.woff2" type="font/woff2" crossorigin />
      <link rel="preload" as="font" href="/fonts/figtree-700.woff2" type="font/woff2" crossorigin />
    </>}
    {!animated && <link rel="preload" as="font" href="/fonts/bricolage-grotesque-800.woff2" type="font/woff2" crossorigin />}
    {animated && <link rel="preload" as="image" href={openingPoster.src} imagesrcset={openingPoster.srcSet} imagesizes={openingPoster.sizes} fetchpriority="high" />}
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE.name} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${PROFILE.name} — ${PROFILE.jobTitle}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <>
      <meta property="og:image" content={image} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="675" />
      <meta property="og:image:alt" content="Yashika Varshney's illustrated product design portfolio" />
    </>}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <>
      <meta name="twitter:image" content={image} />
      <meta name="twitter:image:alt" content="Yashika Varshney's illustrated product design portfolio" />
    </>}
    <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
  </head>
  <body>
    <slot />
    {animated && <noscript>
      <div style="position:fixed;inset:0;z-index:200;display:grid;place-content:center;gap:1rem;padding:2rem;background:#17110E;color:#FBF5EC;font-family:system-ui,sans-serif;text-align:center">
        <p>Enable JavaScript to watch Yashika's animated portfolio.</p>
        <a href="/portfolio/">Read the portfolio without animation</a>
        <a href="mailto:yashikavarshney.yv@gmail.com">Contact Yashika by email</a>
      </div>
    </noscript>}
  </body>
</html>
