---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioFilm from '../components/PortfolioFilm';
import '../styles/portfolio.css';
---

<BaseLayout animated>
  <main aria-labelledby="portfolio-heading">
    <h1 id="portfolio-heading" class="sr-only">Yashika Varshney — Product Designer &amp; Creative Thinker</h1>
    <PortfolioFilm />
  </main>
  <a class="portfolio-text-link" href="/portfolio/">Read portfolio</a>
</BaseLayout>

<script>
  import '../scripts/film-player';
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .portfolio-text-link { position: fixed; top: 16px; right: 16px; z-index: 130; padding: 10px 16px; border: 1px solid rgba(251,245,236,.5); border-radius: 999px; background: #17110e; color: #fbf5ec; font: 600 14px/1.3 'Figtree',sans-serif; text-decoration: none; }
  .portfolio-text-link:hover { background: #c83e66; color: #fff; }
  .portfolio-text-link:focus-visible { outline: 3px solid #f7e5a6; outline-offset: 3px; }
</style>
